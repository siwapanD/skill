# Database connection string (Postgres recommended)
DATABASE_URL=postgresql://user:password@localhost:5432/mydb  # required

# Secret key for session signing / encryption
AUTH_SECRET=change-me-to-a-random-string  # required

# Base URL of the dev server (used by Auth.js for callbacks)
NEXTAUTH_URL=http://localhost:3000  # required

# GitHub OAuth client secret (or any third-party API key)
GITHUB_SECRET=example-key  # optional
